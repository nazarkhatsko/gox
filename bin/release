#!/bin/sh
# Checks the code, tags a version and pushes main with the tag.
#
#	bin/release          # asks for the version
#	bin/release v1.2.3
set -e

. "$(dirname "$0")/lib.sh"

[ "$(git branch --show-current)" = main ] || fail "release from the main branch"
require_clean

"$(dirname "$0")/check"

version=$1
if [ -z "$version" ]; then
	last=$(git describe --tags --abbrev=0 2>/dev/null || echo none)
	echo
	printf 'Version %s(last: %s)%s: ' "$dim" "$last" "$reset"
	read -r version
fi

echo "$version" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$' ||
	fail "invalid version \"$version\": want vX.Y.Z or vX.Y.Z-pre"
! git rev-parse -q --verify "refs/tags/$version" >/dev/null ||
	fail "tag $version already exists"

echo
step "Tag $version" git tag -a "$version" -m "$version"
# A tag that never reached the remote is removed, so the release can be retried.
trap 'git tag -d "$version" >/dev/null' EXIT
# The checks above already ran, so the pre-push hook is skipped.
step "Push" git push --atomic --no-verify origin main "$version"
trap - EXIT

echo
echo "${green}Released $version${reset}"
