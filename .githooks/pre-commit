#!/bin/sh
# Checks that the staged Go files parse and are formatted, as they will be
# committed. Fully staged files are formatted in place for review; lint and
# tests run before push.
# Enable with `task init`; skip once with `git commit --no-verify`.
set -e
root=$(git rev-parse --show-toplevel)
cd "$root"
. bin/lib.sh

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.go')
[ -n "$files" ] || exit 0

require_tools gofmt golangci-lint

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

broken='' unformatted=''
for f in $files; do
	git show ":$f" >"$tmp/staged"

	if ! err=$(gofmt -e "$tmp/staged" 2>&1 >/dev/null); then
		broken="$broken$(echo "$err" | sed "s|$tmp/staged|$f|")
"
		continue
	fi

	golangci-lint fmt --stdin <"$tmp/staged" >"$tmp/formatted" 2>/dev/null
	cmp -s "$tmp/staged" "$tmp/formatted" || unformatted="$unformatted $f"
done

if [ -n "$broken" ]; then
	status "Format" "${red}✗${reset}"
	printf '%s' "$broken" >&2
	fail "fix the syntax errors, then commit again"
fi

if [ -z "$unformatted" ]; then
	status "Format" "${green}✓${reset}"
	exit 0
fi

status "Format" "${red}✗${reset}"
for f in $unformatted; do
	if git diff --quiet -- "$f"; then
		golangci-lint fmt "$f"
		echo "  $f: formatted" >&2
	else
		# Formatting it would mix in the unstaged changes.
		echo "  $f: has unstaged changes; format it and stage it yourself" >&2
	fi
done
fail "review and stage the formatted files, then commit again"
