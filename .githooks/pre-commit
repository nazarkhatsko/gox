#!/bin/sh
# Formats the code before each commit. Lint and tests run before push.
# Enable with `task init`; skip once with `git commit --no-verify`.
set -e
root=$(git rev-parse --show-toplevel)
. "$root/bin/lib.sh"

if task fmt:check >/dev/null 2>&1; then
	status "Format" "${green}✓${reset}"
	exit 0
fi

task fmt >/dev/null 2>&1
status "Format" "${red}✗${reset}"
git diff --name-only | sed 's/^/  /' >&2
fail "files were reformatted; review and stage them, then commit again"
